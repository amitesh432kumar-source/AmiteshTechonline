# ============ 1. BUSINESS DETAILS (edit these) ============
BUSINESS_NAME=Your Business Name
BUSINESS_TYPE=Clothes Shop
CITY=Your City
OWNER_NAME=Your Name
AI_NAME=Riya
WORKING_TIME=10 AM to 9 PM
TIMEZONE=Asia/Kolkata

# ============ 2. WHATSAPP CLOUD API (from developers.facebook.com) ============
WHATSAPP_TOKEN=paste_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=paste_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=choose_any_secret_word_for_webhook
WHATSAPP_APP_SECRET=paste_app_secret_here
GRAPH_VERSION=v23.0
# Owner's personal WhatsApp number with country code, no + sign. Example: 919876543210
OWNER_WHATSAPP=919876543210

# ============ 3. CLAUDE (from console.anthropic.com) ============
ANTHROPIC_API_KEY=sk-ant-paste_here
CLAUDE_MODEL=claude-sonnet-5-5

# ============ 4. GOOGLE SHEET FOR LEADS (optional but recommended) ============
GOOGLE_SHEET_ID=
# Paste the whole service-account JSON file as ONE line, OR its base64 in the _B64 variable
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_B64=

# ============ 5. FILES TO SEND ============
# Public links (Google Drive "anyone with link" PDF, or your website). Leave empty if none.
CATALOG_URL=
PRICE_LIST_URL=
PAYMENT_LINK=

# ============ 6. FOLLOW-UP ============
# Customer stops replying -> bot sends 1 follow-up after this many hours (must be under 24, see docs)
FOLLOWUP_AFTER_HOURS=22
# Optional: approved WhatsApp template names (needed only to message after the 24 hour window)
FOLLOWUP_TEMPLATE_NAME=
OWNER_ALERT_TEMPLATE_NAME=

# ============ 7. SERVER ============
PORT=3000
DATA_DIR=./data
# 1 = print messages in terminal instead of sending to WhatsApp (testing)
WA_DRY_RUN=0
