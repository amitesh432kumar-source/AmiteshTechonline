# ================= PLATFORM (aapka server - sab creators ke liye ek hi) =================
BASE_URL=http://localhost:3000
PORT=3000

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=low

# --- Database (Supabase / Render / Railway Postgres - kuch bhi) ---
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Google Cloud OAuth (Web application type) ---
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# --- Security (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
# Refresh tokens isse encrypt hoke DB me jaate hain. Kho diya to sab creators ko dobara login karna padega.
ENCRYPTION_KEY=64-hex-characters
SESSION_SECRET=koi-lamba-random-string

# --- Email (owner alerts + weekly report) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="YouTube AI Assistant <you@example.com>"

# --- Quota & limits ---
# Aapke Google Cloud project ka total YouTube quota (default 10000/din, SAB creators me share hota hai)
YOUTUBE_PROJECT_QUOTA=10000
# Ek creator ka max daily quota use (fair share ke upar nahi jayega)
TENANT_MAX_DAILY_UNITS=1500
# Ek creator ke max AI replies per day (Claude ka kharcha control)
TENANT_MAX_AI_REPLIES_PER_DAY=100
COMMENT_POLL_SECONDS=90
MAX_TENANTS=200
